# Supabase Configuration for MISSION 30
# Get these credentials from your Supabase Project Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Note: If these are not configured, MISSION 30 automatically runs in
# persistent Local Demo Mode using LocalStorage with complete data isolation,
# export/import capabilities, and zero data loss!
